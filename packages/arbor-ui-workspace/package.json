{
  "name": "@4fu/dsh-arbor-ui-workspace",
  "version": "2026.1110.4",
  "type": "module",
  "description": "The dsh-arbor browser package for the project picker: arbor's shared-folder projects are listed for an arbor session only, and a directory outside them is marked external",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "client.js",
    "src",
    "LICENSE",
    "locale"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4fuu/dsh-arbor.git",
    "directory": "packages/arbor-ui-workspace"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
