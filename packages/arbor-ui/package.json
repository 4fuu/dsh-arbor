{
  "name": "@4fu/dsh-arbor-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The dsh-arbor browser package: the permanent left-sidebar arbor page, its per-session tabs and live window streams, and for arbor sessions the sandbox access-mode gate; ordinary sessions keep their controls unchanged",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "src"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-permission-presets": "0.2.2-rc.1",
    "@4fu/dsh-arbor-facts": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4fuu/dsh-arbor.git",
    "directory": "packages/arbor-ui"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
