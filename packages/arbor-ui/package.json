{
  "name": "@4fu/dsh-arbor-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The dsh-arbor browser package: for arbor sessions it hides DSH's sandbox access-mode control, which is untrue when arbor's tools run on the host; ordinary sessions keep it unchanged",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-permission-presets": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "^18.2.0"
  }
}
