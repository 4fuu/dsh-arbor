{
  "name": "@4fu/dsh-arbor-bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The dsh-arbor bundle: the patch layer that replaces DSH's agent row with arbor's routing registry and mounts the arbor host, driver and preset",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@4fu/dsh-arbor-driver": "workspace:*",
    "@4fu/dsh-arbor-facts": "workspace:*",
    "@4fu/dsh-arbor-host": "workspace:*",
    "@4fu/dsh-arbor-preset": "workspace:*",
    "@4fu/dsh-arbor-ui": "workspace:*",
    "@4fu/dsh-arbor-ui-workspace": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4fuu/dsh-arbor.git",
    "directory": "packages/arbor-bundle"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
