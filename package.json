{
  "name": "dsh-arbor-spike",
  "private": true,
  "type": "module",
  "description": "B0 spike: running arbor as DeepSeek Harness's agent driver",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "proof:routing": "node --experimental-strip-types --no-warnings proofs/01-routing.ts",
    "proof:roundtrip": "node --experimental-strip-types --no-warnings proofs/02-roundtrip.ts",
    "proof:hidden": "node --experimental-strip-types --no-warnings proofs/03-hidden-windows.ts",
    "proof:approval": "node --experimental-strip-types --no-warnings proofs/04-approval.ts",
    "proof:prompt": "node --experimental-strip-types --no-warnings proofs/05-prompt.ts",
    "proof:plugins": "node --experimental-strip-types --no-warnings proofs/06-plugins.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "@4fu/dsh-arbor-agent": "workspace:*",
    "@4fu/dsh-arbor-testkit": "workspace:*"
  },
  "engines": {
    "node": ">=24.9.0"
  }
